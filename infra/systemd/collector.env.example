# Example ONLY. Copy into root-owned /etc/ccny-shuttle/collector.env
# with mode 0640, group ccnyshuttle, and correct restricted values.
# Never commit a real Samsara token or place it under the public web root.
SAMSARA_API_TOKEN=REPLACE_WITH_RESTRICTED_READ_VEHICLE_STATISTICS_TOKEN
CCNY_SHUTTLE_VEHICLE_IDS=REPLACE_WITH_APPROVED_SHUTTLE_VEHICLE_IDS
